# --- Application ---
NODE_ENV=development
PORT=3000

# --- Base de données (Neon ou tout PostgreSQL avec pooler type PgBouncer) ---
# DATABASE_URL : connexion POOLÉE (avec "-pooler" dans le nom d'hôte chez Neon)
# — utilisée par l'application (PrismaService) à l'exécution.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL : connexion DIRECTE (sans "-pooler") — utilisée uniquement par
# le CLI Prisma pour les migrations (generate/migrate dev/db pull).
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentification ---
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# --- Frontend ---
# Adresse du frontend : le retour de Google (OAuth) y redirige l'utilisateur.
FRONTEND_URL="http://localhost:3001"

# --- Téléversement de photos / pièces KYC (Cloudinary) ---
# Sans ces trois valeurs, POST /uploads/signature répond 503.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- CORS ---
# Origines autorisées, séparées par des virgules. En production : l'URL exacte
# du frontend. Absent = toutes les origines (acceptable seulement en local).
# CORS_ORIGIN="http://localhost:3001"

# --- Paiement (Notch Pay) ---
# Laisser vide tant que le compte sandbox n'est pas prêt.
PAYMENT_AGGREGATOR_API_KEY=""
PAYMENT_WEBHOOK_SIGNING_SECRET=""
PLATFORM_FEE_PERCENT="10"
